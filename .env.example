# =============================================================================
# NACS PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local for local development.
# NEVER commit .env or real secret credentials to the repository.
# =============================================================================

# Current active build target ('development' | 'staging' | 'production')
NACS_ENV=staging
NACS_USE_EMULATORS=false

# -----------------------------------------------------------------------------
# FIREBASE STAGING CONFIGURATION (Project: nacs-platform-staging)
# -----------------------------------------------------------------------------
STAGING_FIREBASE_API_KEY=AIzaSyExampleStagingKey00000000000000
STAGING_FIREBASE_AUTH_DOMAIN=nacs-platform-staging.firebaseapp.com
STAGING_FIREBASE_PROJECT_ID=nacs-platform-staging
STAGING_FIREBASE_STORAGE_BUCKET=nacs-platform-staging.firebasestorage.app
STAGING_FIREBASE_MESSAGING_SENDER_ID=123456789012
STAGING_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
STAGING_APP_CHECK_SITE_KEY=6LxxxxxxxStagingSiteKeyxxxxxxxxxxxxx
# App Check debug token - ONLY valid in staging/dev emulator, NEVER in production!
STAGING_APP_CHECK_DEBUG_TOKEN=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# FIREBASE PRODUCTION CONFIGURATION (Project: nacs-platform-prod)
# -----------------------------------------------------------------------------
PROD_FIREBASE_API_KEY=AIzaSyExampleProdKey0000000000000000
PROD_FIREBASE_AUTH_DOMAIN=nacs-platform-prod.firebaseapp.com
PROD_FIREBASE_PROJECT_ID=nacs-platform-prod
PROD_FIREBASE_STORAGE_BUCKET=nacs-platform-prod.firebasestorage.app
PROD_FIREBASE_MESSAGING_SENDER_ID=987654321098
PROD_FIREBASE_APP_ID=1:987654321098:web:fedcba0987654321
PROD_APP_CHECK_SITE_KEY=6LxxxxxxxProdSiteKeyxxxxxxxxxxxxxxxx
# Note: PROD_APP_CHECK_DEBUG_TOKEN is intentionally absent. Debug tokens are forbidden in prod.

# -----------------------------------------------------------------------------
# DISASTER RECOVERY & BACKUP STORAGE BUCKET
# -----------------------------------------------------------------------------
FIRESTORE_BACKUP_STORAGE_BUCKET=gs://nacs-platform-backups

# -----------------------------------------------------------------------------
# CI/CD SECRETS (Set in GitHub Secrets / Organization repository settings)
# -----------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_NACS_PLATFORM_STAGING
# FIREBASE_SERVICE_ACCOUNT_NACS_PLATFORM_PROD
