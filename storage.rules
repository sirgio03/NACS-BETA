rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // DEFAULT DENY
    // All unmatched paths are rejected.
    // =========================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Strict raster image whitelist: SVGs are explicitly excluded to prevent Stored XSS vectors.
    function isRasterImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function isUnderSize(maxMb) {
      return request.resource.size <= maxMb * 1024 * 1024;
    }

    function userDocExists() {
      return isAuthenticated() && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isBoardOrAdmin() {
      return userDocExists() && (getUserRole() == 'board' || getUserRole() == 'admin');
    }

    // =========================================================================
    // CLUB ASSETS (Logos, badges)
    // Max 2MB, raster image only (JPEG, PNG, WebP).
    // Publicly readable, authenticated write.
    // =========================================================================
    match /clubs/{clubId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() 
                   && isRasterImage() 
                   && isUnderSize(2);
    }

    // =========================================================================
    // PROJECT SHOWCASE ASSETS (Screenshots, gallery images)
    // Max 5MB, raster image only (JPEG, PNG, WebP).
    // Publicly readable, authenticated write.
    // =========================================================================
    match /projects/{projectId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() 
                   && isRasterImage() 
                   && isUnderSize(5);
    }

    // =========================================================================
    // APPLICATION PROOF DOCUMENTS (Official university affiliation letters, charters)
    // Confidential: Restricted strictly to applicant + board/admin accounts,
    // matching the applications collection security rule.
    // Allowed formats: PDF or raster image (JPEG, PNG, WebP). SVGs strictly excluded.
    // Max 10MB per document.
    // =========================================================================
    match /applications/{applicationId}/{fileName} {
      allow read: if isAuthenticated() && (
        isBoardOrAdmin() ||
        request.auth.uid == applicationId ||
        (firestore.exists(/databases/(default)/documents/applications/$(applicationId)) &&
         (firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.contactEmail == request.auth.token.email ||
          firestore.get(/databases/(default)/documents/applications/$(applicationId)).data.submittedData.leadUid == request.auth.uid))
      );
      allow write: if isAuthenticated()
                   && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))')
                   && isUnderSize(10);
    }
  }
}
