rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // GLOBAL DEFAULT DENY
    // All paths not explicitly permitted below are rejected unconditionally.
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return userExists() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isBoard() {
      return hasRole('board');
    }

    function isBoardOrAdmin() {
      return isAuthenticated() && userExists() && 
        (getUserData().role == 'board' || getUserData().role == 'admin');
    }

    // =========================================================================
    // 1. CLUBS COLLECTION
    // Public directory: unauthenticated and regular visitors can ONLY read
    // verified clubs (verified == true). Unverified/pending clubs are strictly
    // restricted to board/admin accounts.
    // All writes must go through Cloud Functions (Admin SDK).
    // =========================================================================
    match /clubs/{clubId} {
      allow read: if resource.data.verified == true || isBoardOrAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 2. EVENTS COLLECTION
    // RULE: Nothing user-submitted is publicly readable until status == 'approved'.
    // Pending or flagged events may only be viewed by the creator or board/admin.
    // All writes go through Cloud Functions for server-side conflict/date validation.
    // =========================================================================
    match /events/{eventId} {
      allow read: if resource.data.status == 'approved'
                  || (isAuthenticated() && (resource.data.createdBy == request.auth.uid || isBoardOrAdmin()));
      allow write: if false;
    }

    // =========================================================================
    // 3. PROJECTS COLLECTION
    // RULE: Only 'approved' projects appear in the public showcase gallery.
    // Submitter or board/admin can inspect pending projects.
    // All writes go through Cloud Functions for image count and tag validation.
    // =========================================================================
    match /projects/{projectId} {
      allow read: if resource.data.status == 'approved'
                  || (isAuthenticated() && (resource.data.submittedBy == request.auth.uid || isBoardOrAdmin()));
      allow write: if false;
    }

    // =========================================================================
    // 4. APPLICATIONS COLLECTION
    // Confidential: Only applicant (matching contactEmail) or board/admin can read.
    // Direct client writes are forbidden; submissions go through callable Cloud
    // Function (submitApplication) with App Check bot protection and schema checks.
    // =========================================================================
    match /applications/{applicationId} {
      allow read: if isAuthenticated() && 
                     (request.auth.token.email == resource.data.contactEmail || isBoardOrAdmin());
      allow write: if false;
    }

    // =========================================================================
    // 5. USERS COLLECTION
    // User profile data.
    // Read: authenticated owner or board/admin.
    // Create / Delete: forbidden from client (provisioned via Cloud Functions auth trigger).
    // Update: authenticated owner can ONLY modify fields in the strict ALLOWLIST.
    // Any new schema fields added in the future are DENIED by default.
    // 'role' and 'clubId' are strictly forbidden from client updates.
    // =========================================================================
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isBoardOrAdmin());
      allow create: if false;
      allow delete: if false;
      allow update: if isOwner(uid) && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                         'displayName', 'photoURL', 'phoneNumber', 'bio', 'updatedAt'
                       ]);
    }

    // =========================================================================
    // 6. ROLE CHANGE AUDIT LOG (roleChangeLog)
    // Governance audit trail recording all role transitions.
    // Confidential: Read restricted to board and admin accounts.
    // Zero client writes: strictly written server-side by Cloud Functions.
    // =========================================================================
    match /roleChangeLog/{logId} {
      allow read: if isBoardOrAdmin();
      allow write: if false;
    }

    // =========================================================================
    // 7. APPLICATION DECISION AUDIT LOG (applicationDecisionLog)
    // Governance audit trail recording all membership approvals and rejections.
    // Confidential: Read restricted to board and admin accounts.
    // Zero client writes: strictly written server-side by Cloud Functions.
    // =========================================================================
    match /applicationDecisionLog/{logId} {
      allow read: if isBoardOrAdmin();
      allow write: if false;
    }
  }
}
