{
  "name": "nacs-functions",
  "scripts": {
    "lint": "echo \"Functions lint skipped for scaffold\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "node -r ts-node/register --test tests/callable-auth.spec.ts tests/callable-lead.spec.ts tests/callable-moderation.spec.ts",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^6.3.2",
    "@google-cloud/firestore": "^7.11.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.8.2"
  },
  "private": true
}
